The following is working:

export INSTALL_PREFIX="${HOME}/.local/llvm-21-mlir"
export PATH="$INSTALL_PREFIX/bin:$PATH"
export MLIR_SYS_210_PREFIX=$INSTALL_PREFIX
export TABLEGEN_210_PREFIX=$INSTALL_PREFIX
export LIBCLANG_PATH="$INSTALL_PREFIX/lib"
export LD_LIBRARY_PATH="$INSTALL_PREFIX/lib:$LD_LIBRARY_PATH"
export BINDGEN_EXTRA_CLANG_ARGS="-I$INSTALL_PREFIX/lib/clang/21/include"

cargo clean
cargo run --bin analyzer -- --help



