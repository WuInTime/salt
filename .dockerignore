# Version-control metadata is not needed inside the image. ARTIFACT_REVISION is
# passed explicitly as a build argument.
.git
.github
.gitignore

# Local configuration and possible secrets.
.env
.envrc
*.pem
*.key

# Build products and generated evaluation outputs. The image rebuilds these.
target/
**/target/
build/
cmake-build-*/
results/
results.old*/
artifact-results/
full-results/
salt_vs_hw_misses_package/benchmarks/bin/
*.log
*.sqlite
*.sqlite-journal
*.db
*.db-journal
*.tar.gz
*.tar.zst
perf.data*
flamegraph.svg
result.txt

# Editor, assistant, cache, and operating-system metadata.
.backup/
.cache/
.codex/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
some_notes.txt
